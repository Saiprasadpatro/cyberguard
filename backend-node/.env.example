# ---- Server ----
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# ---- Database ----
# Matches docker-compose.yml's postgres service by default.
DATABASE_URL=postgres://cyberguard:cyberguard@localhost:5432/cyberguard
DB_SSL=false

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
SESSION_SECRET=replace-with-a-different-long-random-string

# ---- Google OAuth ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- Gemini AI ----
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Online / offline mode ----
# auto    = detect the internet connection and switch automatically (default)
# online  = always allow internet features (Gemini, Gmail, live URL checks)
# offline = never contact the internet; rules + C++ ML models still run fully
CYBERGUARD_MODE=auto

# ---- C++ Detection Engine ----
ENGINE_URL=http://127.0.0.1:5050
# Optional shared secret; must match ENGINE_KEY in detection-engine-cpp if set.
ENGINE_KEY=

# ---- Connect Gmail ----
GMAIL_REDIRECT_URI=http://localhost:4000/api/gmail/callback
TOKEN_ENCRYPTION_KEY=

# ---- Deep URL check (optional Google Safe Browsing) ----
SAFE_BROWSING_API_KEY=

# ---- NIDS sensor push key (defaults to ENGINE_KEY) ----
SENSOR_KEY=
