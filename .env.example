# Copied to .env and used by docker-compose.yml for all services.
# Also copy backend-node/.env.example -> backend-node/.env for non-Docker local runs.

POSTGRES_DB=cyberguard
POSTGRES_USER=cyberguard
POSTGRES_PASSWORD=cyberguard

JWT_SECRET=replace-with-a-long-random-string
SESSION_SECRET=replace-with-a-different-long-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Online / offline mode ----
# auto    = detect the internet connection and switch automatically (default)
# online  = always allow internet features (Gemini, Gmail, live URL checks)
# offline = never contact the internet; rules + C++ ML models still run fully
CYBERGUARD_MODE=auto

ENGINE_KEY=

FRONTEND_URL=http://localhost:8080
REACT_APP_API_URL=http://localhost:4000/api

# ---- Connect Gmail (inbox phishing scan) ----
# Uses the same Google OAuth client as Google login. In Google Cloud Console:
#   enable "Gmail API", add this redirect URI to the OAuth client, and add your
#   Gmail address as a Test user on the OAuth consent screen.
GMAIL_REDIRECT_URI=http://localhost:4000/api/gmail/callback
# Any long random string (e.g. openssl rand -hex 32). Encrypts stored Gmail refresh tokens (AES-256-GCM).
# If empty, a key is derived from JWT_SECRET.
TOKEN_ENCRYPTION_KEY=

# ---- Deep URL check (optional) ----
SAFE_BROWSING_API_KEY=

# ---- Network IDS sensor (optional, docker compose --profile live) ----
NIDS_IFACE=eth0
NIDS_BPF=
# Sensors authenticate with ENGINE_KEY (set it!). SENSOR_KEY overrides it on the backend only.
SENSOR_KEY=
